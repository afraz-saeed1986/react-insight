{
  "name": "@react-insight/inspector",
  "version": "0.1.0",
  "description": "On-demand component inspection built on top of @react-insight/react.",
  "keywords": [
    "react",
    "react-insight",
    "inspector",
    "debugging",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afraz-saeed1986/react-insight.git"
  },
  "homepage": "https://github.com/afraz-saeed1986/react-insight",
  "bugs": {
    "url": "https://github.com/afraz-saeed1986/react-insight/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-insight/react": "workspace:*"
  },
  "devDependencies": {
    "@react-insight/eslint-config": "workspace:*",
    "eslint": "^10.6.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}